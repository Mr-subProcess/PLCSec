{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plcsec.dev/schemas/plcsec.artifact-signature.v1.schema.json",
  "title": "PLCSEC Detached Artifact Signature",
  "type": "object",
  "required": ["schema", "artifact_type", "payload_sha256", "payload_size_bytes", "public_key_sha256", "algorithm", "signature_base64", "created_at"],
  "properties": {
    "schema": {"const": "plcsec.artifact-signature.v1"},
    "artifact_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload_size_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728},
    "public_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "algorithm": {"const": "Ed25519"},
    "signature_base64": {"type": "string", "minLength": 80, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
