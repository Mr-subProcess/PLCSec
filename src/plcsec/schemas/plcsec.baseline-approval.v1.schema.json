{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plcsec.dev/schemas/plcsec.baseline-approval.v1.schema.json",
  "title": "PLCSEC Signed Baseline Approval Record",
  "type": "object",
  "required": ["schema", "baseline_sha256", "site_id", "baseline_created_at", "approved_by", "reason", "approved_at", "approval_semantics"],
  "properties": {
    "schema": {"const": "plcsec.baseline-approval.v1"},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "site_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "baseline_created_at": {"type": ["string", "null"]},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_semantics": {"type": "string"}
  },
  "additionalProperties": false
}
