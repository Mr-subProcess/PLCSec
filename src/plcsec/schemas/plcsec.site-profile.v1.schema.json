{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plcsec.example/schemas/plcsec.site-profile.v1.schema.json",
  "title": "PLCSEC Site Profile v1",
  "description": "Operator-maintained OT zone and directed conduit profile for passive flow review.",
  "type": "object",
  "required": ["schema", "site_id", "zones"],
  "properties": {
    "schema": {"const": "plcsec.site-profile.v1"},
    "site_id": {"type": "string", "minLength": 1},
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["name", "cidrs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cidrs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {"type": "string", "pattern": "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$", "description": "Must be a valid IPv4/IPv6 CIDR; PLCSEC performs semantic ipaddress validation."}
          }
        },
        "additionalProperties": true
      }
    },
    "approved_conduits": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["source_zone", "destination_zone", "transport", "destination_port"],
        "properties": {
          "source_zone": {"type": "string", "minLength": 1},
          "destination_zone": {"type": "string", "minLength": 1},
          "transport": {"type": "string", "enum": ["tcp", "udp"]},
          "destination_port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "purpose": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
